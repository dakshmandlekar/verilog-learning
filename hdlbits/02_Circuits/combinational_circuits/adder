module top_module (
    input [3:0] x,
    input [3:0] y, 
    output [4:0] sum);
    wire cout1 , cout2, cout3 ;
    full_adder add1( x[0] , y[0] , 1'b0 ,sum[0] ,cout1 );
    full_adder add2( x[1] , y[1] , cout1 , sum[1] , cout2 );
    full_adder add3( x[2] , y[2] , cout2 , sum[2] , cout3 );
    full_adder add4( x[3] , y[3] , cout3 , sum[3] , sum[4] );

endmodule


module full_adder ( input a , input b , input cin , output sum , output cout );
    assign sum = a^b^cin ;
     assign cout = a&b | b&cin | cin&a ;
    
endmodule
